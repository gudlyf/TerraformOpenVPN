# OpenVPN client profile "${client}" for ${server_address}.
# Generated by Terraform (TerraformOpenVPN). Contains a private key: keep it safe.
client
dev tun
proto ${protocol}
remote ${server_address} ${port}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name ${server_common_name} name
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3
<ca>
${trimspace(ca_cert)}
</ca>
<cert>
${trimspace(client_cert)}
</cert>
<key>
${trimspace(client_key)}
</key>
<tls-crypt>
${trimspace(tls_crypt_key)}
</tls-crypt>
